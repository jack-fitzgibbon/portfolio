{
  "name": "jack-fitzgibbon",
  "version": "1.0.0",
  "description": "Jack Fitzgibbon's Portfolio",
  "private": true,
  "scripts": {
    "build": "npm run clean && node scripts/build.js --prod",
    "dev": "npm run clean --silent && npm run build-dev && npm run start-dev --silent",
    "build-dev": "node scripts/build.js",
    "start-dev": "concurrently \"npm run watch\" \"npm run serve-dist\"",
    "watch": "nodemon --quiet --ext html,css,js,json,otf,ico,png,jpg,jpeg,gif,svg --watch src --ignore node_modules --ignore dist --delay 500ms --exec \"node scripts/build.js\"",
    "serve-dist": "cd dist && live-server --port=3000 --wait=250 --no-css-inject",
    "clean": "shx rm -rf dist"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "concurrently": "^9.2.0",
    "html-minifier": "^4.0.0",
    "live-server": "^1.2.2",
    "nodemon": "^3.1.10",
    "shx": "^0.4.0"
  },
  "author": "Jack Fitzgibbon",
  "license": "MIT"
}
